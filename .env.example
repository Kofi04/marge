# --- Supabase (projet cloud) ---
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
# Clé secrète — NE JAMAIS exposer côté client ni commiter. Sert au seed et à
# d'éventuelles opérations admin côté serveur.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Référence du projet, pour `supabase link --project-ref <ref>`
SUPABASE_PROJECT_REF=<project-ref>

# URL publique de l'app (redirections OAuth / magic link)
# Port 4321 : 3000 est réservé par Windows (plage exclue) sur cette machine.
NEXT_PUBLIC_SITE_URL=http://localhost:4321

# --- OAuth ---
# Les client_id / secret GitHub et Google se configurent dans le dashboard
# Supabase (Auth → Providers), pas ici. Callback à déclarer côté provider :
#   https://<project-ref>.supabase.co/auth/v1/callback
